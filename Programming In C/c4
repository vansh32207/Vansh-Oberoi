#include <stdio.h>

int main()
{
    int arr[100], n, i, sum = 0;
    int *ptr;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    ptr = arr;

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", ptr + i);
    }

    printf("Array elements are: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", *(ptr + i));
        sum = sum + *(ptr + i);
    }

    printf("\nSum of array elements = %d\n", sum);

    return 0;
}