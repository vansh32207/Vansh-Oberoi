#include <stdio.h>

int main()
{
    int i, j;

    for (i = 1; i <= 5; i++)
    {
        int stars;

        if (i <= 3)
            stars = 2 * i - 1;
        else
            stars = 2 * (5 - i) + 1;

        for (j = 1; j <= stars; j++)
        {
            printf("*\n");
        }

        if (i < 5)
            printf("\n");
    }

    return 0;
}