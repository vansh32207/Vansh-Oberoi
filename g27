#include <stdio.h>
#include <math.h>

int main()
{
    int n, first, last, digits, swapped;

    printf("Enter a number: ");
    scanf("%d", &n);

    digits = (int)log10(n);
    first = n / (int)pow(10, digits);
    last = n % 10;

    swapped = last * (int)pow(10, digits)
              + (n % (int)pow(10, digits))
              - last + first;

    printf("Number after swapping = %d\n", swapped);

    return 0;
}